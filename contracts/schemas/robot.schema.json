{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "display_name",
    "root_link_id",
    "links",
    "components",
    "joints",
    "electrical_connections",
    "controllers"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "display_name": {
      "type": "string"
    },
    "root_link_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "base_component_id",
          "initial_transform"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "base_component_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "initial_transform": {
            "type": "object",
            "required": [
              "position_m",
              "rotation_xyzw"
            ],
            "properties": {
              "position_m": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "rotation_xyzw": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "additionalProperties": false
          },
          "is_root": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "catalogue_id",
          "catalogue_version",
          "link_id",
          "transform"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "catalogue_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "catalogue_version": {
            "type": "string"
          },
          "catalogue_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "link_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "transform": {
            "type": "object",
            "required": [
              "position_m",
              "rotation_xyzw"
            ],
            "properties": {
              "position_m": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "rotation_xyzw": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "additionalProperties": false
          },
          "overrides": {
            "type": "object",
            "properties": {
              "size_m": {
                "type": "array",
                "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
                "minItems": 3,
                "maxItems": 3
              },
              "display_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "camera": {
                "type": "object",
                "required": ["horizontal_fov_deg", "resolution_width_px", "resolution_height_px", "near_clip_m", "far_clip_m", "enabled"],
                "properties": {
                  "horizontal_fov_deg": { "type": "number", "minimum": 10, "maximum": 170 },
                  "resolution_width_px": { "type": "integer", "minimum": 16, "maximum": 4096 },
                  "resolution_height_px": { "type": "integer", "minimum": 16, "maximum": 4096 },
                  "near_clip_m": { "type": "number", "exclusiveMinimum": 0 },
                  "far_clip_m": { "type": "number", "exclusiveMinimum": 0 },
                  "enabled": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "joints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "parent_link_id",
          "child_link_id",
          "axis_local",
          "parent_frame",
          "child_frame"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "fixed",
              "revolute",
              "continuous",
              "prismatic"
            ]
          },
          "parent_link_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "child_link_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "parent_component_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "child_component_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "axis_local": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "parent_frame": {
            "type": "object",
            "required": [
              "position_m",
              "rotation_xyzw"
            ],
            "properties": {
              "position_m": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "rotation_xyzw": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "additionalProperties": false
          },
          "child_frame": {
            "type": "object",
            "required": [
              "position_m",
              "rotation_xyzw"
            ],
            "properties": {
              "position_m": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "rotation_xyzw": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "additionalProperties": false
          },
          "limits": {
            "type": "object",
            "required": [
              "lower",
              "upper"
            ],
            "properties": {
              "lower": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "enum": [
                  "rad",
                  "m"
                ]
              }
            },
            "additionalProperties": false
          },
          "actuator_component_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "parent_port_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "child_port_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "joint_profile_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "joint_profile_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        },
        "additionalProperties": false
      }
    },
    "electrical_connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "interface"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "from": {
            "type": "string",
            "minLength": 3
          },
          "to": {
            "type": "string",
            "minLength": 3
          },
          "interface": {
            "type": "string",
            "enum": [
              "uart",
              "gpio",
              "pwm",
              "i2c",
              "spi",
              "power",
              "encoder",
              "motor_channel",
              "can",
              "usb_video"
            ]
          },
          "bus_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "physical_pin": {
            "type": "string",
            "pattern": "^P[A-Z][0-9]{1,2}$"
          }
        },
        "additionalProperties": false
      }
    },
    "component_mount_connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "parent_component_id",
          "parent_port_id",
          "child_component_id",
          "child_port_id"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" },
          "parent_component_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" },
          "parent_port_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" },
          "child_component_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" },
          "child_port_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" }
        },
        "additionalProperties": false
      }
    },
    "controllers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "component_instance_id",
          "board",
          "firmware"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "component_instance_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "board": {
            "type": "string",
            "const": "stm32f4_discovery_stm32f407vg"
          },
          "firmware": {
            "type": "object",
            "required": [
              "relative_path",
              "target"
            ],
            "properties": {
              "relative_path": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "const": "stm32f407vg"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          },
          "uart_channels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
